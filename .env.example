# ---------------------------------------------------------------------------
# Emerald Lottery Platform — environment
# Copy to .env.local for local development. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Application mode.
#   mock — in-memory demo provider, seeded data, no database required (default)
#   live — requires a real repository provider (see src/repositories/index.ts)
NEXT_PUBLIC_APP_MODE=mock

# Canonical public URL. Used for absolute URLs in metadata / Open Graph.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session signing key (HS256). MUST be at least 32 characters.
# Generate with:  openssl rand -base64 48
# Required in production; a development fallback is used only when NODE_ENV!=production.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Production only — not used while NEXT_PUBLIC_APP_MODE=mock
# ---------------------------------------------------------------------------

# PostgreSQL. On serverless, point DATABASE_URL at a POOLED connection
# (PgBouncer / Neon pooler / Supabase pooler / Prisma Accelerate) and DIRECT_URL
# at the unpooled one so `prisma migrate` can run. See PERFORMANCE.md.
DATABASE_URL=
DIRECT_URL=

# Redis — cache, cross-instance rate limiting, and the BullMQ job queue.
REDIS_URL=
